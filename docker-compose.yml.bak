
services:

  unix-server:
    build:
      context: ./unix-server
      dockerfile: Dockerfile

    container_name: incidentops-unix-server
    hostname: unix-server-01

    ports:
      - "9100:9100"

    restart: unless-stopped

  db-server:
    build:
      context: ./db-server
      dockerfile: Dockerfile

    container_name: incidentops-db-server
    hostname: db-server-01

    ports:
      - "9101:9100"

    restart: unless-stopped

  prometheus:
    image: prom/prometheus:latest

    container_name: incidentops-prometheus

    ports:
      - "9090:9090"

    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus/rules:/etc/prometheus/rules:ro

    depends_on:
      - unix-server
      - alertmanager

    restart: unless-stopped

  alertmanager:
    image: prom/alertmanager:latest

    container_name: incidentops-alertmanager

    ports:
      - "9093:9093"

    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro

    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"

    restart: unless-stopped

  kafka:
    image: apache/kafka:latest

    container_name: incidentops-kafka

    ports:
      - "9092:9092"

    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller

      KAFKA_LISTENERS: INTERNAL://:29092,EXTERNAL://:9092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: INTERNAL://kafka:29092,EXTERNAL://localhost:9092

      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: INTERNAL

      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093

      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
      KAFKA_NUM_PARTITIONS: 3

  alert-service:
    image: incidentops-alert-service:1.0

    container_name: incidentops-alert-service

    ports:
      - "8080:8080"

    environment:
      KAFKA_BOOTSTRAP_SERVERS: kafka:29092
      FRONTEND_ORIGIN: http://localhost:5173

    depends_on:
      - kafka

    restart: unless-stopped

  incident-service:
    image: incidentops-incident-service:1.0

    container_name: incidentops-incident-service

    # Rebuild only the Incident Service when Java code changes
    build:
      context: ./services/incident-service
      dockerfile: Dockerfile

    ports:
      - "8081:8081"

    environment:
      KAFKA_BOOTSTRAP_SERVERS: kafka:29092

      DB_URL: "jdbc:postgresql://postgres:5432/incidentops?options=-c%20TimeZone=UTC"

      JWT_SECRET: "${JWT_SECRET:?Set JWT_SECRET to the same value used by User Service}"

      FRONTEND_ORIGIN: "http://localhost:5173"

      # Spring Boot -> FastAPI AI Agent
      AI_AGENT_URL: "http://incidentops-ai-agent-test:8000"

      # Same secret as INTERNAL_API_KEY in AI Agent .env
      AI_AGENT_INTERNAL_API_KEY: "${AI_AGENT_INTERNAL_API_KEY:?Set AI_AGENT_INTERNAL_API_KEY}"

    depends_on:
      - kafka
      - postgres

    restart: unless-stopped

  user-service:
    image: incidentops-user-service:1.0

    container_name: incidentops-user-service

    ports:
      - "8083:8083"

    environment:
      DB_URL: "jdbc:postgresql://postgres:5432/incidentops"

      JWT_SECRET: "${JWT_SECRET:?MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=}"

      ADMIN_USERNAME: "${ADMIN_USERNAME:?admin}"
      ADMIN_PASSWORD: "${ADMIN_PASSWORD:?ChangeMe123!}"

      FRONTEND_ORIGIN: "http://localhost:5173"
      AUTH_COOKIE_SECURE: "false"

    depends_on:
      - postgres

    restart: unless-stopped

  frontend:
    image: incidentops-frontend:1.0

    container_name: incidentops-frontend

    ports:
      - "5173:80"

    depends_on:
      - user-service
      - incident-service
      - alert-service

    restart: unless-stopped

  postgres:
    image: postgres:17

    container_name: incidentops-postgres

    environment:
      POSTGRES_DB: incidentops
      POSTGRES_USER: incidentops
      POSTGRES_PASSWORD: incidentops

    ports:
      - "5433:5432"

    volumes:
      - postgres_data:/var/lib/postgresql/data

    restart: unless-stopped

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:latest

    container_name: incidentops-cadvisor

    ports:
      - "8082:8080"

    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk:/dev/disk:ro

    privileged: true

    restart: unless-stopped

volumes:
  postgres_data:
